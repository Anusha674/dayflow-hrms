# Copy to backend/.env — .env is git-ignored and must never be committed.
DATABASE_URL=mysql+pymysql://dayflow:change-me@localhost:3306/dayflow_hrms
JWT_SECRET=replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (email verification + notification mail)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dayflow.io

UPLOAD_DIR=./storage/documents
MAX_UPLOAD_MB=5
